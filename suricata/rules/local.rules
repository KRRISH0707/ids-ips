# ==============================================================================
# Enterprise IDS/IPS Real-Time Suricata Signatures
# ==============================================================================

# ── 1. Web Application & API Attacks ─────────────────────────────────────────
alert http any any -> any any (msg:"APEX-IDS: SQL Injection - UNION SELECT detected"; flow:established,to_server; content:"UNION"; nocase; http_uri; content:"SELECT"; nocase; http_uri; classtype:web-application-attack; sid:1000001; rev:1; metadata:confidence high, severity critical;)
alert http any any -> any any (msg:"APEX-IDS: SQL Injection - Boolean Tautology 'OR 1=1'"; flow:established,to_server; content:"or"; nocase; http_uri; content:"1=1"; nocase; http_uri; classtype:web-application-attack; sid:1000002; rev:1; metadata:confidence high, severity high;)
alert http any any -> any any (msg:"APEX-IDS: Directory Traversal - /etc/passwd pattern"; flow:established,to_server; content:"../"; http_uri; content:"etc/passwd"; nocase; http_uri; classtype:attempted-recon; sid:1000003; rev:1; metadata:confidence high, severity high;)
alert http any any -> any any (msg:"APEX-IDS: Command Injection - UNIX pipe or command separator"; flow:established,to_server; pcre:"/(\x7c|\x3b|\x26|\x60|\$\().*(cat|whoami|id|bash|sh|wget|curl)/i"; classtype:attempted-admin; sid:1000004; rev:2; metadata:confidence high, severity critical;)
alert http any any -> any any (msg:"APEX-IDS: Remote Code Execution - Apache Log4j JNDI Lookup"; flow:established,to_server; content:"${jndi:"; nocase; classtype:attempted-admin; sid:1000005; rev:1; metadata:confidence high, severity critical;)
alert http any any -> any any (msg:"APEX-IDS: Cross-Site Scripting - Stored/Reflected Script Tag"; flow:established,to_server; content:"<script"; nocase; http_uri; classtype:web-application-attack; sid:1000006; rev:1; metadata:confidence medium, severity medium;)

# ── 2. Network Floods & Port Scans ───────────────────────────────────────────
alert tcp any any -> any any (msg:"APEX-IDS: TCP SYN Stealth Scan"; flags:S; flow:stateless; threshold:type both, track by_src, count 20, seconds 5; classtype:attempted-recon; sid:1000010; rev:1; metadata:confidence high, severity high;)
alert tcp any any -> any any (msg:"APEX-IDS: TCP NULL Scan detected"; flags:0; flow:stateless; classtype:attempted-recon; sid:1000011; rev:1; metadata:confidence high, severity medium;)
alert tcp any any -> any any (msg:"APEX-IDS: TCP XMAS Scan detected"; flags:FPU; flow:stateless; classtype:attempted-recon; sid:1000012; rev:1; metadata:confidence high, severity medium;)
alert tcp any any -> any any (msg:"APEX-IDS: TCP FIN Scan detected"; flags:F; flow:stateless; classtype:attempted-recon; sid:1000013; rev:1; metadata:confidence high, severity medium;)
alert icmp any any -> any any (msg:"APEX-IDS: ICMP Echo Flood"; itype:8; threshold:type both, track by_src, count 50, seconds 2; classtype:denial-of-service; sid:1000014; rev:1; metadata:confidence high, severity medium;)

# ── 3. Credential & Brute Force Attacks ──────────────────────────────────────
alert tcp any any -> any 22 (msg:"APEX-IDS: SSH Brute Force Ingress Burst"; flow:to_server; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-login-lockout; sid:1000020; rev:1; metadata:confidence high, severity high;)
alert http any any -> any any (msg:"APEX-IDS: HTTP Authentication Failure Burst"; flow:to_server; content:"/login"; nocase; http_uri; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-login-lockout; sid:1000021; rev:1; metadata:confidence high, severity high;)

# ── 4. Malware C2 & Reverse Shells ───────────────────────────────────────────
alert tcp any any -> any any (msg:"APEX-IDS: Suspicious Interactive TTY Reverse Shell"; flow:established; content:"/bin/sh"; nocase; classtype:trojan-activity; sid:1000030; rev:1; metadata:confidence high, severity critical;)
alert tcp any any -> any any (msg:"APEX-IDS: Suspicious Interactive Bash Spawn"; flow:established; content:"/bin/bash"; nocase; classtype:trojan-activity; sid:1000031; rev:1; metadata:confidence high, severity critical;)
alert http any any -> any any (msg:"APEX-IDS: Cobalt Strike Beaconing User-Agent"; flow:established,to_server; content:"MSIE 9.0"; http_header; content:"Trident/5.0"; http_header; classtype:trojan-activity; sid:1000032; rev:2; metadata:confidence high, severity critical;)
