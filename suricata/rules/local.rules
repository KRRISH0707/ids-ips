# ==============================================================================
# Enterprise IDS/IPS Real-Time Suricata Signatures (Production Battle-Ready)
# Classifications: Web App, Exploits, DoS, Recon, Brute Force, C2 & Shells
# ==============================================================================

# ── 1. Web Application & API Attacks ─────────────────────────────────────────
alert http any any -> any any (msg:"APEX-IDS: SQL Injection - UNION SELECT detected"; flow:established,to_server; content:"UNION"; nocase; http_uri; content:"SELECT"; nocase; http_uri; classtype:web-application-attack; sid:1000001; rev:2; metadata:confidence high, severity critical;)
alert http any any -> any any (msg:"APEX-IDS: SQL Injection - Boolean Tautology 'OR 1=1'"; flow:established,to_server; content:"or"; nocase; http_uri; content:"1=1"; nocase; http_uri; classtype:web-application-attack; sid:1000002; rev:2; metadata:confidence high, severity high;)
alert http any any -> any any (msg:"APEX-IDS: SQL Injection - Time-Based Blind SLEEP/BENCHMARK"; flow:established,to_server; pcre:"/(sleep\(|benchmark\(|waitfor\s+delay|pg_sleep\()/i"; classtype:web-application-attack; sid:1000007; rev:1; metadata:confidence high, severity critical;)
alert http any any -> any any (msg:"APEX-IDS: SQL Injection - Information Schema Exfiltration"; flow:established,to_server; content:"information_schema"; nocase; http_uri; classtype:web-application-attack; sid:1000008; rev:1; metadata:confidence high, severity critical;)
alert http any any -> any any (msg:"APEX-IDS: Directory Traversal - /etc/passwd pattern"; flow:established,to_server; content:"../"; http_uri; content:"etc/passwd"; nocase; http_uri; classtype:attempted-recon; sid:1000003; rev:2; metadata:confidence high, severity high;)
alert http any any -> any any (msg:"APEX-IDS: Directory Traversal - Encoded or Windows Win.ini"; flow:established,to_server; pcre:"/(\.\.%2f|\.\.%5c|%2e%2e%2f|\.\.\/|\.\.\\).*(win\.ini|boot\.ini|etc\/shadow|etc\/hosts)/i"; classtype:attempted-recon; sid:1000009; rev:1; metadata:confidence high, severity critical;)
alert http any any -> any any (msg:"APEX-IDS: Command Injection - UNIX Shell Metacharacters"; flow:established,to_server; pcre:"/(\x7c|\x3b|\x26|\x60|\$\().*(cat|whoami|id|bash|sh|wget|curl|nc|chmod|uname)/i"; classtype:attempted-admin; sid:1000004; rev:3; metadata:confidence high, severity critical;)
alert http any any -> any any (msg:"APEX-IDS: Remote Code Execution - Apache Log4j JNDI Lookup"; flow:established,to_server; content:"${jndi:"; nocase; classtype:attempted-admin; sid:1000005; rev:2; metadata:confidence high, severity critical;)
alert http any any -> any any (msg:"APEX-IDS: Remote Code Execution - Spring4Shell ClassLoader"; flow:established,to_server; content:"class.module.classLoader"; nocase; classtype:attempted-admin; sid:1000015; rev:1; metadata:confidence high, severity critical;)
alert http any any -> any any (msg:"APEX-IDS: Cross-Site Scripting - Stored/Reflected Script Tag"; flow:established,to_server; content:"<script"; nocase; http_uri; classtype:web-application-attack; sid:1000006; rev:2; metadata:confidence medium, severity medium;)
alert http any any -> any any (msg:"APEX-IDS: Cross-Site Scripting - Event Handler Injection"; flow:established,to_server; pcre:"/(onerror|onload|onclick|onmouseover)\s*=/i"; classtype:web-application-attack; sid:1000016; rev:1; metadata:confidence high, severity high;)
alert http any any -> any any (msg:"APEX-IDS: Server-Side Request Forgery - Cloud Metadata Access"; flow:established,to_server; pcre:"/169\.254\.169\.254|metadata\.google\.internal/i"; classtype:web-application-attack; sid:1000017; rev:1; metadata:confidence high, severity critical;)
alert http any any -> any any (msg:"APEX-IDS: Web Shell Probe - Common PHP/ASP Web Shell URI"; flow:established,to_server; pcre:"/(c99|r57|b374k|wso|alfa|cmd|shell)\.(php|asp|aspx|jsp)/i"; classtype:web-application-attack; sid:1000018; rev:1; metadata:confidence high, severity critical;)

# ── 2. Network Floods & Port Scans ───────────────────────────────────────────
alert tcp any any -> any any (msg:"APEX-IDS: TCP SYN Stealth Scan"; flags:S; flow:stateless; threshold:type both, track by_src, count 20, seconds 5; classtype:attempted-recon; sid:1000010; rev:2; metadata:confidence high, severity high;)
alert tcp any any -> any any (msg:"APEX-IDS: TCP NULL Scan detected"; flags:0; flow:stateless; classtype:attempted-recon; sid:1000011; rev:2; metadata:confidence high, severity medium;)
alert tcp any any -> any any (msg:"APEX-IDS: TCP XMAS Scan detected"; flags:FPU; flow:stateless; classtype:attempted-recon; sid:1000012; rev:2; metadata:confidence high, severity medium;)
alert tcp any any -> any any (msg:"APEX-IDS: TCP FIN Scan detected"; flags:F; flow:stateless; classtype:attempted-recon; sid:1000013; rev:2; metadata:confidence high, severity medium;)
alert icmp any any -> any any (msg:"APEX-IDS: ICMP Echo Flood"; itype:8; threshold:type both, track by_src, count 50, seconds 2; classtype:denial-of-service; sid:1000014; rev:2; metadata:confidence high, severity medium;)
alert tcp any any -> any any (msg:"APEX-IDS: Volumetric SYN Flood Denial of Service"; flags:S; flow:stateless; threshold:type both, track by_src, count 100, seconds 2; classtype:denial-of-service; sid:1000019; rev:1; metadata:confidence high, severity critical;)

# ── 3. Vulnerability Scanners & Reconnaissance Tools ─────────────────────────
alert http any any -> any any (msg:"APEX-IDS: Scanner Activity - sqlmap Automated Exploiter"; flow:established,to_server; content:"sqlmap"; nocase; http_header; classtype:attempted-recon; sid:1000022; rev:1; metadata:confidence high, severity high;)
alert http any any -> any any (msg:"APEX-IDS: Scanner Activity - Nikto Web Vulnerability Scanner"; flow:established,to_server; content:"Nikto"; nocase; http_header; classtype:attempted-recon; sid:1000023; rev:1; metadata:confidence high, severity high;)
alert http any any -> any any (msg:"APEX-IDS: Scanner Activity - Nuclei Vulnerability Scanner"; flow:established,to_server; content:"nuclei"; nocase; http_header; classtype:attempted-recon; sid:1000024; rev:1; metadata:confidence high, severity high;)
alert http any any -> any any (msg:"APEX-IDS: Scanner Activity - Masscan / Nmap HTTP Prober"; flow:established,to_server; content:"masscan"; nocase; http_header; classtype:attempted-recon; sid:1000025; rev:3; metadata:confidence high, severity high;)
alert http any any -> any any (msg:"APEX-IDS: Scanner Activity - Gobuster / Dirbuster Directory Bruteforce"; flow:established,to_server; content:"gobuster"; nocase; http_header; classtype:attempted-recon; sid:1000026; rev:3; metadata:confidence high, severity medium;)

# ── 4. Credential & Brute Force Attacks ──────────────────────────────────────
alert tcp any any -> any 22 (msg:"APEX-IDS: SSH Brute Force Ingress Burst"; flow:to_server; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-login-lockout; sid:1000020; rev:2; metadata:confidence high, severity high;)
alert http any any -> any any (msg:"APEX-IDS: HTTP Authentication Failure Burst"; flow:to_server; content:"/login"; nocase; http_uri; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-login-lockout; sid:1000021; rev:2; metadata:confidence high, severity high;)
alert tcp any any -> any 3389 (msg:"APEX-IDS: RDP Brute Force Connection Burst"; flow:to_server; threshold:type both, track by_src, count 15, seconds 60; classtype:attempted-login-lockout; sid:1000027; rev:1; metadata:confidence high, severity high;)
alert tcp any any -> any 21 (msg:"APEX-IDS: FTP Brute Force Ingress Burst"; flow:to_server; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-login-lockout; sid:1000028; rev:1; metadata:confidence high, severity high;)

# ── 5. Malware C2, Reverse Shells & Ransomware ───────────────────────────────
alert tcp any any -> any any (msg:"APEX-IDS: Suspicious Interactive TTY Reverse Shell"; flow:established; content:"/bin/sh"; nocase; classtype:trojan-activity; sid:1000030; rev:2; metadata:confidence high, severity critical;)
alert tcp any any -> any any (msg:"APEX-IDS: Suspicious Interactive Bash Spawn"; flow:established; content:"/bin/bash"; nocase; classtype:trojan-activity; sid:1000031; rev:2; metadata:confidence high, severity critical;)
alert http any any -> any any (msg:"APEX-IDS: Cobalt Strike Beaconing User-Agent"; flow:established,to_server; content:"MSIE 9.0"; http_header; content:"Trident/5.0"; http_header; classtype:trojan-activity; sid:1000032; rev:3; metadata:confidence high, severity critical;)
alert tcp any any -> any any (msg:"APEX-IDS: Windows PowerShell Encoded Download Cradle"; flow:established,to_server; pcre:"/powershell.*(-enc|-encodedcommand)\s+[A-Za-z0-9+\/=]{20,}/i"; classtype:trojan-activity; sid:1000033; rev:1; metadata:confidence high, severity critical;)
alert tcp any any -> any 445 (msg:"APEX-IDS: Ransomware Activity - Volume Shadow Copy Deletion Command"; flow:established,to_server; content:"vssadmin"; nocase; content:"delete shadows"; nocase; classtype:trojan-activity; sid:1000034; rev:1; metadata:confidence high, severity critical;)
alert tcp any any -> any any (msg:"APEX-IDS: Meterpreter Reverse TCP Payload Connection"; flow:established; content:"MZ"; depth:2; content:"This program cannot be run in DOS mode"; classtype:trojan-activity; sid:1000035; rev:1; metadata:confidence high, severity critical;)
