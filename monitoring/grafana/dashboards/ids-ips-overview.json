{
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus"}],
  "title": "IDS/IPS Overview",
  "uid": "ids-ips-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Open Alerts",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "ids_open_alerts", "legendFormat": "Open Alerts"}],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Alerts Ingested (1h)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "increase(ids_alerts_ingested_total[1h])", "legendFormat": ""}],
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Sensors",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "ids_active_sensors", "legendFormat": ""}],
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Blocked IPs (total)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "ids_blocked_ips_total", "legendFormat": ""}],
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Alert Ingest Rate by Severity",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "rate(ids_alerts_ingested_total[5m])", "legendFormat": "{{severity}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "options": {"tooltip": {"mode": "multi"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API Request Duration (p99)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "histogram_quantile(0.99, rate(ids_api_request_duration_seconds_bucket[5m]))", "legendFormat": "p99 {{path}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Auth Attempts",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "rate(ids_auth_attempts_total[5m])", "legendFormat": "{{result}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Active Incidents",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "ids_active_incidents", "legendFormat": "Active Incidents"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "pluginId": "prometheus",
        "hide": 0
      }
    ]
  }
}
