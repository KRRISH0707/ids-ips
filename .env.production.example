# ==============================================================================
# ENTERPRISE IDS/IPS PRODUCTION CONFIGURATION
# ==============================================================================

# ── Domain & Public Hostname ──────────────────────────────────────────────────
# e.g. soc.yourcompany.com
DOMAIN=soc.yourcompany.com

# ── Production Administrator Account ──────────────────────────────────────────
ADMIN_EMAIL=krrish183224@gmail.com
ADMIN_PASSWORD=183@Krrish

# ── Cryptographic Secrets ─────────────────────────────────────────────────────
# Generate via: openssl rand -hex 32
JWT_SECRET=change-this-to-a-cryptographically-secure-random-64-char-secret

# ── Relational Database (PostgreSQL) ──────────────────────────────────────────
POSTGRES_USER=idsips
POSTGRES_DB=idsips
POSTGRES_PASSWORD=generate-strong-random-db-password-here

# ── Redis Cache & PubSub ──────────────────────────────────────────────────────
REDIS_PASSWORD=generate-strong-random-redis-password-here

# ── Observability (Grafana) ───────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=generate-strong-grafana-password-here

# ── IPS Controller Mode ───────────────────────────────────────────────────────
# Set to 'false' on Linux production servers to apply real iptables drop rules.
# Set to 'true' only if running on Windows or environments without NET_ADMIN.
IPS_SIMULATION_MODE=false

# ── Cross-Origin Resource Sharing (CORS) ──────────────────────────────────────
# Comma-separated domains allowed to connect to API
CORS_ORIGINS=https://soc.yourcompany.com

# ── Cloudflare Zero-Trust Tunnel Token ────────────────────────────────────────
# Obtained from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
# If configured, your server requires ZERO open inbound ports on your firewall!
CLOUDFLARE_TUNNEL_TOKEN=

